{
  "manifest_version": 3,
  "name": "Beecrowd Companion",
  "version": "1.0.0",
  "description": "Editor integrado estilo VS Code com execução de testes para o Beecrowd",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "beecrowd-companion@local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "tabs",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*.beecrowd.com/*",
    "*://*.beecrowd.com.br/*",
    "*://*.urionlinejudge.com.br/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "sidebar_action": {
    "default_panel": "sidepanel.html",
    "default_title": "Beecrowd Companion"
  },
  "action": {
    "default_title": "Abrir Beecrowd Companion"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.beecrowd.com/*",
        "*://*.beecrowd.com.br/*",
        "*://*.urionlinejudge.com.br/*"
      ],
      "js": ["content-loader.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.js", "assets/*"],
      "matches": [
        "*://*.beecrowd.com/*",
        "*://*.beecrowd.com.br/*",
        "*://*.urionlinejudge.com.br/*"
      ]
    }
  ]
}
